// Crafting and smelting. Ingredients are item names or #tags.
(
    tags: {
        "planks": ["oak_planks", "birch_planks", "spruce_planks", "jungle_planks", "acacia_planks", "dark_oak_planks", "cherry_planks"],
        "logs": ["oak_log", "birch_log", "spruce_log", "jungle_log", "acacia_log", "dark_oak_log", "cherry_log"],
        "coals": ["coal", "charcoal"],
        "stone_tool_materials": ["cobblestone", "mossy_cobblestone"],
        "wool": ["white_wool", "orange_wool", "magenta_wool", "light_blue_wool", "yellow_wool", "lime_wool", "pink_wool", "gray_wool", "light_gray_wool", "cyan_wool", "purple_wool", "blue_wool", "brown_wool", "green_wool", "red_wool", "black_wool"],
    },
    shaped: [
        (pattern: ["#", "#"], key: {'#': "#planks"}, result: "stick", count: 4),
        (pattern: ["##", "##"], key: {'#': "#planks"}, result: "crafting_table"),
        (pattern: ["###", "# #", "###"], key: {'#': "#stone_tool_materials"}, result: "furnace"),
        (pattern: ["###", "# #", "###"], key: {'#': "#planks"}, result: "chest"),
        (pattern: ["WWW", "PPP"], key: {'W': "#wool", 'P': "#planks"}, result: "red_bed"),
        (pattern: ["C", "S"], key: {'C': "#coals", 'S': "stick"}, result: "torch", count: 4),
        (pattern: ["XXX", " / ", " / "], key: {'X': "#planks", '/': "stick"}, result: "wooden_pickaxe"),
        (pattern: ["XX", "X/", " /"], key: {'X': "#planks", '/': "stick"}, result: "wooden_axe"),
        (pattern: ["X", "/", "/"], key: {'X': "#planks", '/': "stick"}, result: "wooden_shovel"),
        (pattern: ["X", "X", "/"], key: {'X': "#planks", '/': "stick"}, result: "wooden_sword"),
        (pattern: ["XX", " /", " /"], key: {'X': "#planks", '/': "stick"}, result: "wooden_hoe"),
        (pattern: ["XXX", " / ", " / "], key: {'X': "#stone_tool_materials", '/': "stick"}, result: "stone_pickaxe"),
