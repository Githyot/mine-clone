        (pattern: ["  #", " #s", "# s"], key: {'#': "stick", 's': "string"}, result: "fishing_rod", count: 1),
        (pattern: [" # ", "# #"], key: {'#': "spruce_planks"}, result: "spruce_roof", count: 6),
