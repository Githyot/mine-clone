        (pattern: ["R", "S"], key: {'R': "redstone", 'S': "stick"}, result: "redstone_torch"),
        (pattern: ["S", "C"], key: {'S': "stick", 'C': "cobblestone"}, result: "lever"),
        (pattern: ["##"], key: {'#': "stone"}, result: "stone_pressure_plate"),
