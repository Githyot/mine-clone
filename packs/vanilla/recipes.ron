        (pattern: ["TRT", "SSS"], key: {'T': "redstone_torch", 'R': "redstone", 'S': "stone"}, result: "repeater"),
        (pattern: ["PPP", "CIC", "CRC"], key: {'P': "#planks", 'C': "cobblestone", 'I': "iron_ingot", 'R': "redstone"}, result: "piston"),
        // Until there are slimes, string makes a piston sticky.
        (pattern: ["S", "P"], key: {'S': "string", 'P': "piston"}, result: "sticky_piston"),
        (pattern: ["GSG", "SGS", "GSG"], key: {'G': "gunpowder", 'S': "sand"}, result: "tnt"),
