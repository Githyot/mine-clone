// Crafting and smelting. Ingredients are item names or #tags.
(
    tags: {
        "planks": ["oak_planks", "birch_planks", "spruce_planks"],
        "logs": ["oak_log", "birch_log", "spruce_log"],
        "coals": ["coal", "charcoal"],
        "stone_tool_materials": ["cobblestone", "mossy_cobblestone"],
        "wool": ["white_wool", "orange_wool", "magenta_wool", "light_blue_wool", "yellow_wool", "lime_wool", "pink_wool", "gray_wool", "light_gray_wool", "cyan_wool", "purple_wool", "blue_wool", "brown_wool", "green_wool", "red_wool", "black_wool"],
    },
    shaped: [
        (pattern: ["#", "#"], key: {'#': "#planks"}, result: "stick", count: 4),
        (pattern: ["##", "##"], key: {'#': "#planks"}, result: "crafting_table"),
        (pattern: ["###", "# #", "###"], key: {'#': "#stone_tool_materials"}, result: "furnace"),
        (pattern: ["###", "# #", "###"], key: {'#': "#planks"}, result: "chest"),
        (pattern: ["WWW", "PPP"], key: {'W': "#wool", 'P': "#planks"}, result: "red_bed"),
        (pattern: ["C", "S"], key: {'C': "#coals", 'S': "stick"}, result: "torch", count: 4),
        (pattern: ["XXX", " / ", " / "], key: {'X': "#planks", '/': "stick"}, result: "wooden_pickaxe"),
        (pattern: ["XX", "X/", " /"], key: {'X': "#planks", '/': "stick"}, result: "wooden_axe"),
        (pattern: ["X", "/", "/"], key: {'X': "#planks", '/': "stick"}, result: "wooden_shovel"),
        (pattern: ["X", "X", "/"], key: {'X': "#planks", '/': "stick"}, result: "wooden_sword"),
        (pattern: ["XX", " /", " /"], key: {'X': "#planks", '/': "stick"}, result: "wooden_hoe"),
        (pattern: ["XXX", " / ", " / "], key: {'X': "#stone_tool_materials", '/': "stick"}, result: "stone_pickaxe"),
        (pattern: ["XX", "X/", " /"], key: {'X': "#stone_tool_materials", '/': "stick"}, result: "stone_axe"),
        (pattern: ["X", "/", "/"], key: {'X': "#stone_tool_materials", '/': "stick"}, result: "stone_shovel"),
        (pattern: ["X", "X", "/"], key: {'X': "#stone_tool_materials", '/': "stick"}, result: "stone_sword"),
        (pattern: ["XX", " /", " /"], key: {'X': "#stone_tool_materials", '/': "stick"}, result: "stone_hoe"),
        (pattern: ["XXX", "X X"], key: {'X': "leather"}, result: "leather_helmet"),
        (pattern: ["X X", "XXX", "XXX"], key: {'X': "leather"}, result: "leather_chestplate"),
        (pattern: ["XXX", "X X", "X X"], key: {'X': "leather"}, result: "leather_leggings"),
        (pattern: ["X X", "X X"], key: {'X': "leather"}, result: "leather_boots"),
        (pattern: ["XXX", "X X"], key: {'X': "iron_ingot"}, result: "iron_helmet"),
        (pattern: ["X X", "XXX", "XXX"], key: {'X': "iron_ingot"}, result: "iron_chestplate"),
        (pattern: ["XXX", "X X", "X X"], key: {'X': "iron_ingot"}, result: "iron_leggings"),
        (pattern: ["X X", "X X"], key: {'X': "iron_ingot"}, result: "iron_boots"),
        (pattern: ["XXX", "X X"], key: {'X': "gold_ingot"}, result: "golden_helmet"),
        (pattern: ["X X", "XXX", "XXX"], key: {'X': "gold_ingot"}, result: "golden_chestplate"),
        (pattern: ["XXX", "X X", "X X"], key: {'X': "gold_ingot"}, result: "golden_leggings"),
        (pattern: ["X X", "X X"], key: {'X': "gold_ingot"}, result: "golden_boots"),
        (pattern: ["XXX", "X X"], key: {'X': "diamond"}, result: "diamond_helmet"),
        (pattern: ["X X", "XXX", "XXX"], key: {'X': "diamond"}, result: "diamond_chestplate"),
        (pattern: ["XXX", "X X", "X X"], key: {'X': "diamond"}, result: "diamond_leggings"),
        (pattern: ["X X", "X X"], key: {'X': "diamond"}, result: "diamond_boots"),
        (pattern: ["XXX", " / ", " / "], key: {'X': "iron_ingot", '/': "stick"}, result: "iron_pickaxe"),
        (pattern: ["XX", "X/", " /"], key: {'X': "iron_ingot", '/': "stick"}, result: "iron_axe"),
        (pattern: ["X", "/", "/"], key: {'X': "iron_ingot", '/': "stick"}, result: "iron_shovel"),
        (pattern: ["X", "X", "/"], key: {'X': "iron_ingot", '/': "stick"}, result: "iron_sword"),
        (pattern: ["XX", " /", " /"], key: {'X': "iron_ingot", '/': "stick"}, result: "iron_hoe"),
        (pattern: ["XXX", " / ", " / "], key: {'X': "gold_ingot", '/': "stick"}, result: "golden_pickaxe"),
        (pattern: ["XX", "X/", " /"], key: {'X': "gold_ingot", '/': "stick"}, result: "golden_axe"),
        (pattern: ["X", "/", "/"], key: {'X': "gold_ingot", '/': "stick"}, result: "golden_shovel"),
        (pattern: ["X", "X", "/"], key: {'X': "gold_ingot", '/': "stick"}, result: "golden_sword"),
        (pattern: ["XX", " /", " /"], key: {'X': "gold_ingot", '/': "stick"}, result: "golden_hoe"),
        (pattern: ["XXX", " / ", " / "], key: {'X': "diamond", '/': "stick"}, result: "diamond_pickaxe"),
        (pattern: ["XX", "X/", " /"], key: {'X': "diamond", '/': "stick"}, result: "diamond_axe"),
        (pattern: ["X", "/", "/"], key: {'X': "diamond", '/': "stick"}, result: "diamond_shovel"),
        (pattern: ["X", "X", "/"], key: {'X': "diamond", '/': "stick"}, result: "diamond_sword"),
        (pattern: ["XX", " /", " /"], key: {'X': "diamond", '/': "stick"}, result: "diamond_hoe"),
        (pattern: ["###", "###", "###"], key: {'#': "iron_ingot"}, result: "iron_block"),
        (pattern: ["###", "###", "###"], key: {'#': "gold_ingot"}, result: "gold_block"),
        (pattern: ["###", "###", "###"], key: {'#': "diamond"}, result: "diamond_block"),
        (pattern: ["###", "###", "###"], key: {'#': "copper_ingot"}, result: "copper_block"),
        (pattern: ["##", "##"], key: {'#': "brick"}, result: "bricks"),
        (pattern: ["##", "##"], key: {'#': "stone"}, result: "stone_bricks", count: 4),
        (pattern: ["##", "##"], key: {'#': "sand"}, result: "sandstone"),
        (pattern: ["###"], key: {'#': "oak_planks"}, result: "oak_slab", count: 6),
        (pattern: ["###"], key: {'#': "cobblestone"}, result: "cobblestone_slab", count: 6),
        (pattern: ["###"], key: {'#': "stone"}, result: "stone_slab", count: 6),
        (pattern: ["###"], key: {'#': "stone_bricks"}, result: "stone_brick_slab", count: 6),
        (pattern: ["#  ", "## ", "###"], key: {'#': "oak_planks"}, result: "oak_stairs", count: 4),
        (pattern: ["#  ", "## ", "###"], key: {'#': "cobblestone"}, result: "cobblestone_stairs", count: 4),
        (pattern: ["#  ", "## ", "###"], key: {'#': "stone_bricks"}, result: "stone_brick_stairs", count: 4),
        (pattern: [" # ", "# #"], key: {'#': "oak_planks"}, result: "oak_roof", count: 6),
        (pattern: ["# #", " # "], key: {'#': "iron_ingot"}, result: "bucket", count: 1),
        (pattern: [" # ", "# #"], key: {'#': "spruce_planks"}, result: "spruce_roof", count: 6),
        (pattern: [" # ", "# #"], key: {'#': "bricks"}, result: "brick_roof", count: 6),
        (pattern: [" # ", "# #"], key: {'#': "stone_bricks"}, result: "stone_brick_roof", count: 6),
        (pattern: ["#|#", "#|#"], key: {'#': "oak_planks", '|': "stick"}, result: "oak_fence", count: 3),
        (pattern: ["###", "###"], key: {'#': "cobblestone"}, result: "cobblestone_wall", count: 6),
        (pattern: ["###", "###"], key: {'#': "glass"}, result: "glass_pane", count: 16),
        (pattern: ["##", "##", "##"], key: {'#': "oak_planks"}, result: "oak_door", count: 3),
        (pattern: ["###", "###"], key: {'#': "oak_planks"}, result: "oak_trapdoor", count: 2),
        (pattern: ["##", "##"], key: {'#': "string"}, result: "white_wool"),
    ],
    shapeless: [
        (ingredients: ["oak_log"], result: "oak_planks", count: 4),
        (ingredients: ["birch_log"], result: "birch_planks", count: 4),
        (ingredients: ["spruce_log"], result: "spruce_planks", count: 4),
        (ingredients: ["copper_ingot", "copper_ingot", "copper_ingot", "tin_ingot"], result: "bronze_ingot", count: 4),
        (ingredients: ["iron_block"], result: "iron_ingot", count: 9),
        (ingredients: ["gold_block"], result: "gold_ingot", count: 9),
        (ingredients: ["diamond_block"], result: "diamond", count: 9),
        (ingredients: ["copper_block"], result: "copper_ingot", count: 9),
    ],
    smelting: [
        (input: "raw_iron", result: "iron_ingot", xp: 0.7),
        (input: "raw_gold", result: "gold_ingot", xp: 1.0),
        (input: "raw_copper", result: "copper_ingot", xp: 0.7),
        (input: "raw_tin", result: "tin_ingot", xp: 0.7),
        (input: "raw_silver", result: "silver_ingot", xp: 0.7),
        (input: "iron_ore", result: "iron_ingot", xp: 0.7),
        (input: "gold_ore", result: "gold_ingot", xp: 1.0),
        (input: "copper_ore", result: "copper_ingot", xp: 0.7),
        (input: "tin_ore", result: "tin_ingot", xp: 0.7),
        (input: "silver_ore", result: "silver_ingot", xp: 0.7),
        (input: "cobblestone", result: "stone", xp: 0.1),
        (input: "sand", result: "glass", xp: 0.1),
        (input: "clay_ball", result: "brick", xp: 0.3),
        (input: "#logs", result: "charcoal", xp: 0.15),
        (input: "cactus", result: "green_wool", xp: 1.0),
        (input: "porkchop", result: "cooked_porkchop", xp: 0.35),
        (input: "beef", result: "cooked_beef", xp: 0.35),
        (input: "chicken", result: "cooked_chicken", xp: 0.35),
        (input: "mutton", result: "cooked_mutton", xp: 0.35),
    ],
)
