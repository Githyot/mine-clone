                (id: "chefe", text: "Derrote o Quebra-Mundos", hint: "Use o ídolo no Nether. Ele chama esqueletos de cinza e levanta fogo do chão.", need: Boss("world_breaker"), summon: "breaker_idol", said: "O mundo tremeu! Novos minérios brotaram na pedra de cada lugar que você visitar, e o Prisma apareceu. Os monstros ficaram mais fortes."),
                (id: "cobalto", text: "Funda cobalto ou paládio", hint: "Os primeiros minérios novos, entre a superfície e -260.", need: Item(["cobalt_ingot", "palladium_ingot"]), find: Down(-40)),
                (id: "mitril", text: "Funda mitril ou oricalco", hint: "Mais fundo que o cobalto, abaixo de -160. Faça uma bigorna de mitril para os itens novos.", need: Item(["mythril_ingot", "orichalcum_ingot"]), find: Down(-200)),
                (id: "adamantita", text: "Funda adamantita ou titânio", hint: "Os minérios mais fundos do mundo novo, abaixo de -320.", need: Item(["adamantite_ingot", "titanium_ingot"]), find: Down(-360)),
