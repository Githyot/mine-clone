                (id: "verdita", text: "Funda verdita", hint: "Cresce na selva funda depois das máquinas e da Rainha.", need: Item(["verdite_ingot", "raw_verdite"]), find: Biome(["*Jungle*", "Mata Atlântica"])),
                (id: "idolo_escamado", text: "Derrote o Ídolo Escamado", hint: "O Núcleo do Ídolo vai no Altar Escamado, dentro do Templo Escamado, embaixo da selva.", need: Boss("scale_idol"), summon: "idol_core", find: Structure(["templo_escamado"])),
                (id: "duque", text: "Derrote o Duque das Marés", hint: "Isca das Marés: cogumelos brilhantes e um olho de aranha. Jogue no mar ou na praia.", need: Boss("tide_duke"), summon: "tide_bait", optional: true, find: Biome(["*Ocean*", "Beach"])),
                (id: "imperatriz", text: "Derrote a Imperatriz Prismática", hint: "Lâmpada Prismática: almas de luz em volta de pedra luminosa. À noite, no Prisma. De dia ela fica furiosa!", need: Boss("prism_empress"), summon: "prism_lamp", optional: true, find: Land("prism")),
