                (id: "cranio_mecanico", text: "Derrote o Crânio de Aço", hint: "Crânio de Aço: três ferros, duas redstones e um osso. Lute num lugar aberto: ele gira e investe.", need: Boss("mech_skull"), summon: "steel_skull"),
                (id: "verme_mecanico", text: "Derrote a Serpente de Aço", hint: "Verme de Ferro: três ferros, duas redstones e carne podre. Ela cava pela terra; acerte a cabeça.", need: Boss("mech_worm"), summon: "iron_worm"),
