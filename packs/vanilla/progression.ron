// The game's progression (Terraria's idea of a long road with a goal at the end): chapters in
// order, each with goals, a few words the Guide says when it opens and closes, and a reward the
// Guide hands over. Design notes: /mnt/project-files/plan/progressao.md.
//
// `need` kinds:
//   Item([names])     carry any of these (a * at the start or end matches many: "*_log", "cooked_*")
//   Boss(name)        that boss was defeated in this world
//   Npc(name)         that town NPC lives here
//   Dim("nether"|"end")   set foot in that dimension
//   Health(n) / Mana(n)   most health / mana reached n (20 at the start)
//   Depth(y)          stood at height y or below
//   Kill(name, n)     defeated n of that creature (a * works here too)
//   Night             lived through a whole night in survival
//   House             built a valid house (door, light, table, closed room)
//
// A goal that names an item or creature the game doesn't have yet is shown as "em breve" and does
// not block its chapter, so other parts of the game can land later and the road fills in by itself.
// `optional: true` goals are extra: nice to do, not needed to finish the chapter.
(
    chapters: [
        (
            id: "primeiro_dia",
            title: "Primeiro dia",
            intro: "Olá! Eu sou o Guia. Vou te ajudar a sobreviver aqui. Primeiro, madeira: segure o botão esquerdo numa árvore.",
            outro: "Você sobreviveu à primeira noite! Agora vamos fazer deste lugar um lar.",
            reward: [("bread", 4), ("torch", 8)],
            goals: [
                (id: "madeira", text: "Corte madeira", hint: "Segure o botão esquerdo num tronco de árvore até ele soltar. Qualquer árvore serve.", need: Item(["*_log"])),
                (id: "bancada", text: "Faça uma bancada", hint: "Abra o inventário (E), transforme troncos em tábuas e junte 4 tábuas num quadrado 2x2.", need: Item(["crafting_table"])),
                (id: "picareta", text: "Faça uma picareta de madeira", hint: "Coloque a bancada no chão e clique nela com o botão direito. Três tábuas em cima e dois gravetos no meio.", need: Item(["wooden_pickaxe"])),
                (id: "pedra", text: "Minere pedra", hint: "Com a picareta, cave a pedra cinza das encostas ou de um buraco. Ela vira pedregulho.", need: Item(["cobblestone"])),
                (id: "tochas", text: "Faça tochas", hint: "Carvão aparece em pontos pretos na pedra. Carvão em cima de um graveto dá 4 tochas.", need: Item(["torch"])),
                (id: "noite", text: "Sobreviva à primeira noite", hint: "Quando escurecer, monstros saem. Fique num abrigo iluminado, ou cave um buraco e tampe a entrada.", need: Night),
            ],
        ),
        (
            id: "um_lar",
            title: "Um lar de verdade",
            intro: "Um abrigo salva a noite; uma casa traz gente. Construa uma casa com porta, luz e uma mesa, que eu me mudo para ela.",
            outro: "Que casa bonita! Tome estas esmeraldas: com cinco no bolso, um mercador aparece para morar aqui.",
            reward: [("emerald", 5), ("apple", 4)],
            goals: [
                (id: "casa", text: "Construa uma casa", hint: "Um cômodo fechado (paredes, chão e teto), entre 20 e 400 blocos de ar, com porta, uma tocha e uma bancada ou baú.", need: House),
                (id: "fornalha", text: "Faça uma fornalha", hint: "Oito pedregulhos em volta da bancada, deixando o meio vazio.", need: Item(["furnace"])),
                (id: "ferramentas", text: "Faça uma picareta de pedra", hint: "Igual à de madeira, mas com pedregulho em cima. Ela minera ferro.", need: Item(["stone_pickaxe"])),
                (id: "carvao", text: "Junte carvão", hint: "Minere os pontos pretos na pedra, ou queime troncos na fornalha para fazer carvão vegetal.", need: Item(["coal", "charcoal"])),
                (id: "cama", text: "Faça uma cama", hint: "Três lãs em cima e três tábuas embaixo. Tosquie ou derrote ovelhas para conseguir lã. Dormir pula a noite.", need: Item(["red_bed"])),
                (id: "bau", text: "Faça um baú", hint: "Oito tábuas em volta da bancada. Guarde o que não cabe no inventário.", need: Item(["chest"])),
                (id: "comida", text: "Cozinhe alguma comida", hint: "Carne crua na fornalha, com carvão embaixo. Comida cozida enche muito mais a fome.", need: Item(["cooked_*", "bread", "baked_potato"]), optional: true),
            ],
        ),
        (
            id: "metais",
            title: "Metal e comércio",
            intro: "Pedra quebra fácil. Desça nas cavernas atrás de metal: cobre ou estanho primeiro, depois ferro ou chumbo. Cada mundo tem o seu par.",
            outro: "Agora sim, você parece um aventureiro. Lá embaixo, nas profundezas, tem coisa ainda melhor.",
            reward: [("iron_ingot", 4), ("bucket", 1)],
            goals: [
                (id: "rei_geleia", text: "Derrote o Rei Geleia", hint: "Junte gel das geleias e faça a Coroa Gelatinosa (gel em volta de uma barra de ouro). Use na superfície.", need: Boss("king_jelly"), optional: true),
                (id: "cobre", text: "Funda cobre ou estanho", hint: "Minério alaranjado (cobre) ou cinza-claro (estanho) perto da superfície. Derreta na fornalha.", need: Item(["copper_ingot", "tin_ingot"])),
                (id: "ferro", text: "Funda ferro ou chumbo", hint: "Minério com pontos bege (ferro) ou azulados (chumbo), mais fundo. Precisa de picareta de pedra ou melhor.", need: Item(["iron_ingot", "lead_ingot"])),
                (id: "armadura", text: "Vista uma peça de armadura", hint: "Na bancada, lingotes no formato do capacete, peitoral, calça ou botas. Cada ponto de armadura tira 4% do dano.", need: Item(["*_helmet", "*_chestplate", "*_leggings", "*_boots"])),
                (id: "mercador", text: "Atraia um mercador", hint: "Ande com 5 esmeraldas e tenha uma casa livre. Ele vende tochas, comida, baldes e mudas.", need: Npc("npc_merchant")),
                (id: "trigo", text: "Colha trigo", hint: "Quebre grama alta para achar sementes, plante em terra arada perto da água e espere crescer. Um fazendeiro vem morar aqui.", need: Item(["wheat"])),
                (id: "zumbis", text: "Derrote 5 zumbis", hint: "Eles aparecem à noite. Uma espada e um pouco de armadura deixam tudo mais fácil.", need: Kill("zombie", 5)),
                (id: "bronze", text: "Faça bronze", hint: "Cobre e estanho juntos na bancada viram bronze, mais forte que os dois.", need: Item(["bronze_ingot"]), optional: true),
                (id: "fazendeiro", text: "Atraia um fazendeiro", hint: "Ande com sementes, cenouras ou batatas e tenha uma casa livre.", need: Npc("npc_farmer"), optional: true),
            ],
        ),
        (
            id: "profundezas",
            title: "As profundezas",
            intro: "Bem fundo, perto da rocha escura, crescem cristais de vida e metais preciosos. Leve muitas tochas e comida.",
            outro: "Mais vida, mais força. Esses cristais coloridos que você achou guardam magia. Quer aprender?",
            reward: [("torch", 16), ("cooked_beef", 6)],
            goals: [
                (id: "grande_olho", text: "Derrote o Grande Olho", hint: "Seis lentes e um olho de aranha fazem o Olho Suspeito; use à noite. Com 15 corações ele pode vir sozinho.", need: Boss("great_eye"), optional: true),
                (id: "fundo", text: "Desça até a camada 16", hint: "Cave para baixo em escada (nunca reto embaixo de você!). Aperte F3 para ver a altura.", need: Depth(16)),
                (id: "prata", text: "Funda prata ou tungstênio", hint: "Metais das cavernas fundas. A prata é boa contra mortos-vivos.", need: Item(["silver_ingot", "tungsten_ingot"])),
                (id: "ouro", text: "Funda ouro ou platina", hint: "O metal precioso mais fundo antes do diamante.", need: Item(["gold_ingot", "platinum_ingot"])),
                (id: "vida", text: "Use um cristal de vida", hint: "Cristais vermelhos brilhantes no chão das cavernas fundas. Use um para ganhar dois corações a mais.", need: Health(22)),
                (id: "gema", text: "Ache uma gema", hint: "Rubi, safira, topázio e ametista aparecem na pedra funda, em pontos coloridos.", need: Item(["ruby", "sapphire", "topaz", "amethyst"])),
                (id: "enfermeira", text: "Atraia uma enfermeira", hint: "Ela vem depois do primeiro cristal de vida, se houver uma casa livre. Cura você por esmeraldas.", need: Npc("npc_nurse"), optional: true),
                (id: "abaixo_do_mar", text: "Desça abaixo da camada -100", hint: "O mundo continua muito abaixo do zero: túneis compridos, abismos e biomas escondidos. Uma bússola de profundidade mostra a camada.", need: Depth(-100), optional: true),
                (id: "pulo_duplo", text: "Ache um pulo a mais", hint: "Garrafas de nuvem, nevasca ou areia e botas de pulo duplo aparecem nos baús das cabanas e minas das profundezas. Elas se somam!", need: Item(["cloud_bottle", "blizzard_bottle", "sandstorm_bottle", "leap_boots", "cloud_balloon"]), optional: true),
                (id: "aranhas", text: "Derrote 3 aranhas", hint: "Elas sobem paredes e caçam no escuro. Soltam linha, boa para arcos.", need: Kill("spider", 3), optional: true),
            ],
        ),
        (
            id: "magia",
            title: "O caminho da magia",
            intro: "Gemas viram varinhas. Uma varinha gasta mana, as estrelas azuis do canto da tela, e lança feitiços de longe.",
            outro: "Um mago de verdade! Agora você já pode enfrentar algo grande. Vamos falar do Guardião da Floresta.",
            reward: [("mana_crystal", 1), ("lapis_lazuli", 4)],
            goals: [
                (id: "varinha", text: "Faça uma varinha ou cajado", hint: "Na bancada, uma gema na ponta de dois gravetos. Cada gema tem seu feitiço.", need: Item(["*_wand", "*_staff", "*_tome"])),
                (id: "mago", text: "Atraia um mago", hint: "Ele aparece quando você carrega um item mágico e tem uma casa livre. Vende tomos e cristais de mana.", need: Npc("npc_wizard")),
                (id: "mana", text: "Aumente sua mana", hint: "Cristais de mana dão mais uma estrela. O mago vende.", need: Mana(22)),
                (id: "esqueletos", text: "Derrote 5 esqueletos", hint: "Treine a pontaria com magia: esqueletos atiram de longe.", need: Kill("skeleton", 5), optional: true),
            ],
        ),
        (
            id: "guardiao",
            title: "O Guardião da Floresta",
            intro: "Dizem que uma Semente Ancestral, plantada à noite, acorda o Guardião da Floresta. Prepare armadura, comida e uma arena aberta.",
            outro: "Você derrotou o Guardião! Um ferreiro ouviu falar e quer morar aqui. Ele forja metais melhores.",
            reward: [("diamond", 2), ("life_crystal", 1)],
            goals: [
                (id: "mente_chaga", text: "Derrote a Mente da Chaga", hint: "A Espinha da Chaga se usa abaixo da altura 0. Mate os rastejantes antes: eles protegem a Mente.", need: Boss("blight_mind"), optional: true),
                (id: "rainha_colmeia", text: "Derrote a Rainha da Colmeia", hint: "Quebre a larva no meio de uma colmeia gigante, embaixo da selva, ou use o Favo Real na selva.", need: Boss("hive_queen"), optional: true),
                (id: "musgo", text: "Junte pedregulho com musgo", hint: "Aparece em ruínas, criptas e cavernas úmidas.", need: Item(["mossy_cobblestone"])),
                (id: "semente", text: "Faça a Semente Ancestral", hint: "Na bancada: mudas nos cantos, maçãs nos lados e pedregulho com musgo no meio.", need: Item(["ancient_seed"])),
                (id: "chefe", text: "Derrote o Guardião da Floresta", hint: "Use a semente à noite. Na metade da vida ele fica bravo e chama mortos. Fique longe da pisada.", need: Boss("forest_guardian")),
                (id: "ferreiro", text: "Atraia o ferreiro", hint: "Depois do Guardião, ele vem morar numa casa livre e vende lingotes raros.", need: Npc("npc_smith")),
            ],
        ),
        (
            id: "gelo",
            title: "Os mortos do gelo",
            intro: "Com o Guardião caído, algo frio acorda. Faça uma filactéria e enfrente o Lich numa noite gelada. Antes, ache diamantes.",
            outro: "O Lich virou pó! Com uma picareta de diamante você já corta obsidiana. Sabe o que isso quer dizer?",
            reward: [("ender_pearl", 2), ("obsidian", 4)],
            goals: [
                (id: "colosso", text: "Derrote o Colosso do Gelo", hint: "Use o Chifre Gelado na neve. Pule as linhas de espinhos de gelo.", need: Boss("frost_colossus"), optional: true),
                (id: "diamante", text: "Ache um diamante", hint: "Bem fundo, perto da rocha escura. Precisa de picareta de ferro ou melhor.", need: Item(["diamond"])),
                (id: "picareta_diamante", text: "Faça uma picareta de diamante", hint: "Três diamantes e dois gravetos. É a única que minera obsidiana.", need: Item(["diamond_pickaxe"])),
                (id: "filacteria", text: "Faça a filactéria", hint: "Ossos nos cantos, safiras nos lados e um cristal de mana no meio.", need: Item(["lich_phylactery"])),
                (id: "lich", text: "Derrote o Lich", hint: "Use a filactéria à noite. Ele solta anéis de gelo: pule e afaste-se.", need: Boss("lich")),
                (id: "armadura_rara", text: "Vista armadura de platina ou tungstênio", hint: "O ferreiro vende os lingotes, se o seu mundo não tiver o minério.", need: Item(["platinum_chestplate", "tungsten_chestplate", "diamond_chestplate"]), optional: true),
            ],
        ),
        (
            id: "nether",
            title: "Abaixo do mundo: o Nether",
            intro: "Uma moldura de obsidiana de 4 por 5, acesa com isqueiro, abre um portal para o Nether. Lá é quente e hostil: leve tudo.",
            outro: "Você voltou do Nether inteiro! Agora falta o último lugar: o Fim. Pérolas de ender apontam o caminho.",
            reward: [("ender_pearl", 4), ("life_crystal", 1)],
            goals: [
                (id: "obsidiana", text: "Junte obsidiana", hint: "Água sobre lava parada vira obsidiana. Minere com picareta de diamante.", need: Item(["obsidian"])),
                (id: "isqueiro", text: "Faça um isqueiro", hint: "Ferro e sílex. O sílex sai do cascalho.", need: Item(["flint_and_steel"])),
                (id: "entrar", text: "Entre no Nether", hint: "Monte a moldura de 4x5, acenda por dentro e fique parado no portal.", need: Dim("nether")),
                (id: "verruga", text: "Colha verruga do Nether", hint: "Cresce em areia das almas, nas fortalezas do Nether. Base de poções.", need: Item(["nether_wart"])),
                (id: "coracao", text: "Faça o Coração de Obsidiana", hint: "Obsidiana nos cantos, ouro nos lados e um diamante no meio.", need: Item(["obsidian_heart"])),
                (id: "obsidilito", text: "Derrote o Obsidilito", hint: "Ele levanta pilares de fogo embaixo de você: não fique parado.", need: Boss("obsidilith")),
                (id: "submundo", text: "Chegue ao Submundo", hint: "Lá no fundo do mundo, abaixo da camada -608: cinzas, um mar de lava e torres em ruínas. Leve poções e um gancho.", need: Depth(-640), optional: true),
                (id: "magmarita", text: "Funda magmarita", hint: "Minério alaranjado que brilha nas cinzas do Submundo. Precisa de picareta de diamante.", need: Item(["magmarite_ingot"]), optional: true),
                (id: "quartzo", text: "Minere quartzo", hint: "Pontos brancos na pedra do Nether.", need: Item(["quartz"]), optional: true),
                (id: "blaze", text: "Pegue uma vara de blaze", hint: "Os blazes vivem nas fortalezas do Nether.", need: Item(["blaze_rod"]), optional: true),
                (id: "netherite", text: "Faça um lingote de netherite", hint: "Detritos antigos no fundo do Nether, derretidos e misturados com ouro.", need: Item(["netherite_ingot"]), optional: true),
                (id: "wither", text: "Derrote o Wither", hint: "Três crânios sobre areia das almas em T. Lute longe de casa!", need: Boss("wither"), optional: true),
            ],
        ),
        (
            id: "fim",
            title: "O Fim",
            intro: "Olhos de ender, feitos de pérola, voam até a fortaleza enterrada. Lá dentro, uma moldura espera doze olhos.",
            outro: "Você venceu o Guardião do Vazio. O mundo inteiro fala do seu nome! Mas há forças maiores acordando...",
            reward: [("diamond", 4), ("emerald", 10)],
            goals: [
                (id: "perola", text: "Junte pérolas de ender", hint: "Os andarilhos do vazio soltam. Não olhe nos olhos deles!", need: Item(["ender_pearl"])),
                (id: "olho", text: "Faça olhos de ender", hint: "Pérola de ender com pó de blaze, ou o que a receita do seu mundo pedir. Jogue um no ar para ver a direção.", need: Item(["ender_eye"])),
                (id: "entrar_fim", text: "Entre no Fim", hint: "Complete a moldura do portal na fortaleza enterrada e pule dentro.", need: Dim("end")),
                (id: "guardiao_vazio", text: "Derrote o Guardião do Vazio", hint: "Quebre os cristais no alto dos pilares primeiro: eles curam o chefe.", need: Boss("void_guardian")),
                (id: "flor", text: "Derrote a Flor do Vazio", hint: "Semente do Vazio: folhas da selva, pérolas e um cristal de vida.", need: Boss("void_blossom"), optional: true),
                (id: "dragao", text: "Derrote o Dragão do Fim", hint: "Ele circula os pilares. Flechas e feitiços quando ele pousar.", need: Boss("ender_dragon"), optional: true),
                (id: "elitros", text: "Ache élitros", hint: "Nas cidades do Fim, nas ilhas de fora.", need: Item(["elytra"]), optional: true),
            ],
        ),
        (
            id: "encantos",
            title: "Encantos e poções",
            intro: "Para o que vem por aí, ferro e diamante não bastam. Encante seu equipamento e prepare poções.",
            outro: "Com encantos e poções você está pronto para mexer com as forças que dormem neste mundo.",
            reward: [("lapis_lazuli", 8), ("experience_bottle", 8)],
            goals: [
                (id: "mesa", text: "Faça uma mesa de encantamento", hint: "Livro, diamantes e obsidiana. Estantes em volta deixam os encantos mais fortes.", need: Item(["enchanting_table"])),
                (id: "bigorna", text: "Faça uma bigorna", hint: "Blocos e lingotes de ferro. Junta encantos e conserta ferramentas.", need: Item(["anvil"])),
                (id: "alquimia", text: "Faça um suporte de poções", hint: "Vara de blaze e pedregulho.", need: Item(["brewing_stand"])),
                (id: "pocao", text: "Prepare uma poção", hint: "Água, verruga do Nether e um ingrediente que dá o efeito.", need: Item(["potion_*", "*_potion"])),
                (id: "farol", text: "Acenda um farol", hint: "Precisa da estrela do Wither e de uma pirâmide de metal.", need: Item(["beacon"]), optional: true),
            ],
        ),
        (
            id: "quebra_mundo",
            title: "O Quebra-Mundo",
            intro: "O Quebra-Mundo dorme sob a terra. Se cair, o mundo muda para sempre: novos minérios, terras que se espalham e monstros mais fortes.",
            outro: "O mundo mudou! Minérios novos brotaram nas pedras. Você vai precisar deles.",
            reward: [("diamond", 6)],
            goals: [
                (id: "chefe", text: "Derrote o Quebra-Mundo", hint: "Invoque-o com o item que o ferreiro sabe fazer. Lute no subterrâneo, com espaço.", need: Boss("world_breaker")),
                (id: "cobalto", text: "Funda cobalto ou paládio", hint: "Os primeiros minérios novos. Precisam de uma picareta forte.", need: Item(["cobalt_ingot", "palladium_ingot"])),
                (id: "mitril", text: "Funda mitril ou oricalco", hint: "Mais fundo que o cobalto.", need: Item(["mythril_ingot", "orichalcum_ingot"])),
                (id: "adamantita", text: "Funda adamantita ou titânio", hint: "Os minérios mais fundos do mundo novo.", need: Item(["adamantite_ingot", "titanium_ingot"])),
                (id: "meteoro", text: "Consiga um cajado de meteoro", hint: "Um cajado que faz chover estrelas. Veja no livro de receitas (U) do que ele é feito.", need: Item(["meteor_staff"]), optional: true),
                (id: "gancho", text: "Faça um gancho", hint: "Um gancho puxa você até onde ele prender.", need: Item(["*_hook"]), optional: true),
            ],
        ),
        (
            id: "lenda",
            title: "A lenda",
            intro: "Três máquinas antigas guardam o caminho para o fim de tudo. Depois delas, só resta o último chefe.",
            outro: "Você é a lenda deste mundo. Tudo aqui conta a sua história. Obrigado por me deixar acompanhar!",
            reward: [("emerald", 30)],
            goals: [
                (id: "olho_mecanico", text: "Derrote o Olho Mecânico", hint: "A primeira das três máquinas. Cada uma tem seu item de invocação: veja no livro de receitas (U).", need: Boss("mech_eye")),
                (id: "cranio_mecanico", text: "Derrote o Crânio Mecânico", hint: "A segunda máquina. Lute num lugar aberto, ele gira e investe.", need: Boss("mech_skull")),
                (id: "verme_mecanico", text: "Derrote o Verme Mecânico", hint: "A terceira máquina cava pela terra. Acerte a cabeça.", need: Boss("mech_worm")),
                (id: "verdita", text: "Junte verdita", hint: "Cresce na lama da selva funda depois das máquinas.", need: Item(["verdite_ingot", "verdite_ore"])),
                (id: "final", text: "Derrote o último chefe", hint: "O caminho fica claro quando as máquinas caírem.", need: Boss("celestial_herald")),
                (id: "lumita", text: "Forje lumita", hint: "Só o último chefe deixa cair.", need: Item(["lumite_ingot"])),
                (id: "asas", text: "Voe com asas", hint: "Asas são o acessório final de movimento.", need: Item(["*_wings"]), optional: true),
            ],
        ),
    ],
)
