                (id: "pilares", text: "Derrube os quatro pilares", hint: "Solar, Vórtice, Nebulosa e Pó Estelar. Os monstros de cada pilar baixam o escudo dele.", need: Bosses(["pillar_solar", "pillar_vortex", "pillar_nebula", "pillar_stardust"], 4)),
